# Port the server listens on.
# Locally we use 3001 so the Next.js frontend can own 3000.
# On Render this is injected automatically - DO NOT set it there.
PORT=3001

# Comma-separated list of browser origins allowed to call this API.
# Leave unset to allow all origins (local dev convenience).
# On Render set this to your deployed frontend URL, e.g.
#   CORS_ORIGIN=https://poc-nextjs-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000
