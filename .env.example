# Port the server listens on.
# Locally we use 3001 so the Next.js frontend can own 3000.
# On a container host this is injected - do not hardcode it there.
PORT=3001

# Comma-separated list of browser origins allowed to call this API.
# Unset falls back to http://localhost:3000 - never a wildcard.
# In production set this to your deployed frontend URL, e.g.
#   CORS_ORIGIN=https://poc-nextjs-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000
